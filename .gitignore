# Only application source and reproducibility files belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/README.md
!/requirements-windows.lock
!/ptera-source.json
!/setup_windows.py
!/Setup Windows.cmd
!/Run Wing Studies.cmd
!/Run Master Catalog.cmd
!/Check Installation.cmd
!/WingStudy/
!/PteraSoftware
!/tests/
!/docs/
!/examples/
__pycache__/
*.py[cod]
*.nbc
*.nbi
.env
.env.*
*.log
WingStudy/tmp*/

!/tools/
!/Open Results.cmd
!/Open Master Excel.cmd

# Share recorded studies and the master catalog; keep caches and old packages local.
!/outputs/
/outputs/*
!/outputs/studies/
!/outputs/provenance/
!/outputs/master_runs.xlsx
!/outputs/master_runs.sqlite3
!/outputs/master_runs_old.xlsx
!/outputs/master_runs_old.sqlite3
outputs/studies/**/*.tmp
