{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KSam37/wing-studies/schema/study-spec.schema.json",
  "title": "FAAV Wing Studies: study spec",
  "description": "studies/<id>/spec.json. wingstudy/studies/spec.py is the authoritative validator (it also checks the chord zero-suffix rule, repeats, seed rules and the case budget); tests/test_studies.py keeps this schema in step with it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "author",
    "question",
    "kind",
    "models",
    "frequencies_hz"
  ],
  "properties": {
    "schema": {
      "const": "wingstudy/study-spec@1"
    },
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80,
      "description": "YYYY-MM-DD-short-name; must equal the folder name"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "question": {
      "type": "string",
      "minLength": 3,
      "maxLength": 600,
      "description": "What the study should answer"
    },
    "kind": {
      "enum": [
        "evolutionary",
        "geometry-sweep",
        "design-set"
      ],
      "description": "evolutionary: coordinate-climb searches from seeds under an objective; geometry-sweep: scrambled-Sobol outlines; design-set: re-solve chosen outlines"
    },
    "structure": {
      "enum": [
        "chordwise",
        "spanwise",
        "matched"
      ],
      "default": "chordwise",
      "description": "matched solves every wing chordwise-only and with spanwise bending; an evolutionary search climbs chordwise and re-solves each winner matched"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "rigid",
          "t1.00",
          "t0.50",
          "t0.25",
          "t0.20",
          "t0.50r",
          "t0.25r"
        ]
      },
      "description": "Plate models as in the atlas: tN.NN = sheet thickness in mm, r = 5/3 mm leading-edge rod. No rigid for spanwise or matched structure."
    },
    "frequencies_hz": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "minimum": 0.25,
        "maximum": 3.0
      }
    },
    "numerics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/numerics"
      },
      "default": [
        {
          "span_panels": 8,
          "chord_panels": 4,
          "steps_per_cycle": 50,
          "cycles": 4
        }
      ],
      "description": "Evolutionary studies take exactly one setting"
    },
    "wings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "designs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/design"
          }
        },
        "from_atlas": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$"
          },
          "description": "Atlas design keys; their outlines are copied in"
        }
      },
      "description": "design-set: the outlines to solve. evolutionary: optional extra seed outlines (each must obey the search rules)"
    },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "half_span_mm"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "half_span_mm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 100,
            "maximum": 800
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectives"
      ],
      "description": "Evolutionary search. Each model x frequency x objective is one search; every search runs one lineage per seed half-span x seed family plus one per seed wing.",
      "properties": {
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "lambda"
                ],
                "properties": {
                  "lambda": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10,
                    "description": "maximize T/Tref - lambda * M/Mref (Tref, Mref from the search's own seeds)"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "torque_budget_Nm"
                ],
                "properties": {
                  "torque_budget_Nm": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 20,
                    "description": "maximize mean thrust with peak root torque at most this"
                  }
                }
              }
            ]
          }
        },
        "seed_half_spans_mm": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "number",
            "minimum": 100,
            "maximum": 800
          }
        },
        "seed_families": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "enum": [
              "triangle",
              "square",
              "concave",
              "convex",
              "narrow"
            ]
          },
          "description": "Seed shapes with a 200 mm root; give with seed_half_spans_mm"
        },
        "solves_per_lineage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 60
        },
        "step_mm": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "description": "chord change per move (half of it on the one retry)"
        },
        "min_chord_mm": {
          "type": "number",
          "minimum": 5,
          "maximum": 100,
          "default": 10,
          "description": "smallest positive chord; shorter tips become zero"
        },
        "decreasing": {
          "type": "boolean",
          "default": true,
          "description": "chords never increase toward the tip"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cases"
      ],
      "properties": {
        "max_cases": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "parent": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "geometry-sweep"
          }
        }
      },
      "then": {
        "required": [
          "sweep"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "wings"
              ]
            },
            {
              "required": [
                "search"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "design-set"
          }
        }
      },
      "then": {
        "required": [
          "wings"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "sweep"
              ]
            },
            {
              "required": [
                "search"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "evolutionary"
          }
        }
      },
      "then": {
        "required": [
          "search"
        ],
        "not": {
          "required": [
            "sweep"
          ]
        }
      }
    }
  ],
  "$defs": {
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "span_panels": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32,
          "default": 8
        },
        "chord_panels": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16,
          "default": 4
        },
        "steps_per_cycle": {
          "type": "integer",
          "minimum": 20,
          "maximum": 400,
          "default": 50
        },
        "cycles": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10,
          "default": 4
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chords_mm",
        "half_span_mm"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "chords_mm": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 400
          },
          "description": "8 equally spaced stations, root to tip; positive chords 5-400 mm, zeros only as a tip suffix"
        },
        "half_span_mm": {
          "type": "number",
          "minimum": 100,
          "maximum": 800
        }
      }
    }
  }
}
