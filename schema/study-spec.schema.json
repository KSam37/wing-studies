{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KSam37/wing-studies/schema/study-spec.schema.json",
  "title": "FAAV Wing Studies: study spec",
  "description": "studies/<id>/spec.json. wingstudy/studies/spec.py is the authoritative validator (it also checks the chord zero-suffix rule, repeats and the case budget); tests/test_studies.py keeps this schema in step with it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "author", "question", "kind", "models", "frequencies_hz"],
  "properties": {
    "schema": {"const": "wingstudy/study-spec@1"},
    "id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80,
           "description": "YYYY-MM-DD-short-name; must equal the folder name"},
    "title": {"type": "string", "minLength": 3, "maxLength": 120},
    "author": {"type": "string", "minLength": 1, "maxLength": 60},
    "question": {"type": "string", "minLength": 3, "maxLength": 600, "description": "What the study should answer"},
    "kind": {"enum": ["design-set", "geometry-sweep", "matched-comparison"]},
    "structure": {"enum": ["chordwise", "spanwise"], "default": "chordwise",
                  "description": "Ignored by matched-comparison, which solves both"},
    "models": {"type": "array", "minItems": 1, "uniqueItems": true,
               "items": {"enum": ["rigid", "t1.00", "t0.50", "t0.25", "t0.20", "t0.50r", "t0.25r"]},
               "description": "Plate models as in the atlas: tN.NN = sheet thickness in mm, r = 5/3 mm leading-edge rod. No rigid for spanwise or matched studies."},
    "frequencies_hz": {"type": "array", "minItems": 1, "uniqueItems": true,
                       "items": {"type": "number", "minimum": 0.25, "maximum": 3.0}},
    "numerics": {"type": "array", "minItems": 1, "uniqueItems": true,
                 "items": {"$ref": "#/$defs/numerics"},
                 "default": [{"span_panels": 8, "chord_panels": 4, "steps_per_cycle": 50, "cycles": 4}]},
    "wings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "designs": {"type": "array", "items": {"$ref": "#/$defs/design"}},
        "from_atlas": {"type": "array", "uniqueItems": true,
                       "items": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
                       "description": "Atlas design keys; their outlines are copied in"}
      }
    },
    "sweep": {
      "type": "object", "additionalProperties": false, "required": ["count", "half_span_mm"],
      "properties": {
        "count": {"type": "integer", "minimum": 1, "maximum": 4096},
        "half_span_mm": {"type": "array", "minItems": 2, "maxItems": 2,
                         "items": {"type": "number", "minimum": 100, "maximum": 800}},
        "seed": {"type": "integer", "minimum": 0}
      }
    },
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_cases"],
               "properties": {"max_cases": {"type": "integer", "minimum": 1}}},
    "parent": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "geometry-sweep"}}},
     "then": {"required": ["sweep"], "not": {"required": ["wings"]}},
     "else": {"required": ["wings"], "not": {"required": ["sweep"]}}}
  ],
  "$defs": {
    "numerics": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "span_panels": {"type": "integer", "minimum": 2, "maximum": 32, "default": 8},
        "chord_panels": {"type": "integer", "minimum": 2, "maximum": 16, "default": 4},
        "steps_per_cycle": {"type": "integer", "minimum": 20, "maximum": 400, "default": 50},
        "cycles": {"type": "integer", "minimum": 2, "maximum": 10, "default": 4}
      }
    },
    "design": {
      "type": "object", "additionalProperties": false, "required": ["chords_mm", "half_span_mm"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 60},
        "chords_mm": {"type": "array", "minItems": 8, "maxItems": 8,
                      "items": {"type": "number", "minimum": 0, "maximum": 400},
                      "description": "8 equally spaced stations, root to tip; positive chords 5-400 mm, zeros only as a tip suffix"},
        "half_span_mm": {"type": "number", "minimum": 100, "maximum": 800}
      }
    }
  }
}
